# Copie para .env e ajuste. Nunca versione o arquivo .env.

# Conexão da APLICAÇÃO: usuário de login SEM posse das tabelas (o RLS se aplica a ele).
DATABASE_URL=postgres://prisma_app_login:TROQUE_ESTA_SENHA@localhost:5432/prisma_os
# Conexão das MIGRATIONS: usuário proprietário do schema (usado apenas por `npm run db:migrate`).
MIGRATION_DATABASE_URL=postgres://prisma_owner:TROQUE_ESTA_SENHA@localhost:5432/prisma_os

# URL pública da aplicação (usada em links e verificação de origem).
APP_URL=http://localhost:3000
SESSION_TTL_HOURS=72

# Armazenamento de arquivos (driver local; S3/Supabase Storage previsto).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=15

# Provedor de IA: anthropic | openai | demo | none.
# Sem AI_PROVIDER, usa "anthropic" se ANTHROPIC_API_KEY estiver definida; senão
# "openai" se OPENAI_API_KEY estiver definida.
# "demo" monta textos a partir do briefing SEM IA (bloqueado em produção).
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Opcional: força um esforço (low|medium|high|xhigh|max) para todas as skills.
# Vazio = esforço definido por skill (ideias "low"; textos e revisão "medium").
ANTHROPIC_EFFORT=
# "default" ativa o fallback do servidor da Anthropic em caso de recusa por política; "off" desativa.
ANTHROPIC_FALLBACKS=default
AI_TIMEOUT_MS=180000
GENERATION_RATE_PER_MINUTE=10

# Opcional: cores da marca pelo @ do Instagram (API oficial da Meta, "Business
# Discovery"; só contas comerciais ou de criador). Sem as duas, a tela orienta a
# usar o logotipo ou um print do perfil. Veja docs/OPERATIONS.md.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# ChatGPT (OpenAI). A chave é criada em platform.openai.com > API keys (a
# assinatura do ChatGPT não inclui API; o uso é cobrado à parte).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Opcional: força um esforço de raciocínio (low|medium|high|xhigh|max).
OPENAI_EFFORT=

# Opcional: Google Drive (pasta de fotos e vídeos de cada cliente). Chave JSON
# de uma conta de serviço do Google Cloud com a API do Drive ativada, inteira ou
# em base64. Compartilhe as pastas com o e-mail da conta de serviço (Leitor).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Limite por arquivo importado do Drive (MB). Vídeos costumam ser maiores que o envio pela tela.
DRIVE_IMPORT_MAX_MB=100

# Chave mestra que criptografa as chaves dos apps, as conexões das redes e a
# senha do e-mail guardadas no banco. 32 caracteres aleatórios ou mais (ex.:
# `openssl rand -hex 32`). Guarde junto com o backup: sem ela, essas
# informações precisam ser cadastradas de novo.
APP_SECRET_KEY=

# Opcional: chaves dos apps das redes sociais. Também podem ser salvas em
# Integrações (ficam criptografadas no banco); definidas aqui, têm prioridade.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Worker de tarefas assíncronas.
WORKER_POLL_MS=1000
JOB_LOCK_TIMEOUT_MS=600000

# Confiar no cabeçalho X-Forwarded-For (somente atrás de proxy confiável).
TRUST_PROXY=false
