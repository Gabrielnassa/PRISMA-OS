{
  // PRISMA OS no GitHub Codespaces: banco PostgreSQL, site e worker numa
  // máquina na nuvem do GitHub. A porta 3000 é privada (só a sua conta acessa).
  "name": "PRISMA OS",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "initializeCommand": "bash .devcontainer/gerar-senhas.sh",
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  "postStartCommand": "bash .devcontainer/iniciar.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "PRISMA OS", "onAutoForward": "notify" }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Opcional. Chave da API Anthropic para gerar textos com IA. Sem ela, as peças são criadas pelos templates.",
      "documentationUrl": "https://platform.claude.com"
    },
    "OPENAI_API_KEY": {
      "description": "Opcional. Chave da API OpenAI (ChatGPT), criada em platform.openai.com > API keys. Usada quando não há chave da Anthropic ou com AI_PROVIDER=openai.",
      "documentationUrl": "https://platform.openai.com/api-keys"
    },
    "GOOGLE_SERVICE_ACCOUNT_JSON": {
      "description": "Opcional. Chave JSON (ou base64) de uma conta de serviço do Google com a API do Drive, para importar as fotos e vídeos das pastas dos clientes."
    },
    "META_ACCESS_TOKEN": {
      "description": "Opcional. Token da API oficial da Meta (instagram_basic, pages_read_engagement) para sugerir cores da marca pelo @ do Instagram."
    },
    "META_IG_USER_ID": {
      "description": "Opcional. ID numérico da conta comercial do Instagram da agência (usada para consultar os perfis)."
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/COMO-USAR.md"] }
  }
}
